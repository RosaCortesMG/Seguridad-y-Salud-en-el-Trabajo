rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() { return request.auth != null; }
    function esDueno(uid) { return autenticado() && request.auth.uid == uid; }
    function texto(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function opcional(d, campo, max) {
      return !(campo in d) || (d[campo] is string && d[campo].size() <= max);
    }
    function tiposValidos() {
      return ['pausa_activa', 'pausa_motivacional', 'campana_informativa', 'sugerencia_aprendizaje'];
    }

    // ---- Perfiles de usuarios de RH ----
    // usuarios/{uid}: nombre, email, empresa?, cargo?, rol, creado
    match /usuarios/{uid} {
      // Cada quien lee solo su propio perfil.
      allow read: if esDueno(uid);

      // Crear el propio perfil al registrarse. Nadie puede asignarse otro rol
      // ni usar un correo distinto al de su cuenta.
      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'empresa', 'cargo', 'rol', 'creado'])
        && request.resource.data.keys().hasAll(['nombre', 'email', 'rol', 'creado'])
        && texto(request.resource.data.nombre, 120)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.rol == 'rrhh'
        && request.resource.data.creado == request.time
        && opcional(request.resource.data, 'empresa', 120)
        && opcional(request.resource.data, 'cargo', 120);

      // Editar solo nombre, empresa y cargo (email, rol y fecha son fijos).
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'empresa', 'cargo'])
        && texto(request.resource.data.nombre, 120)
        && opcional(request.resource.data, 'empresa', 120)
        && opcional(request.resource.data, 'cargo', 120);

      allow delete: if false;
    }

    // ---- Notas rápidas de cada usuario de RH ----
    // usuarios/{uid}/notas/{id}: titulo, texto, importancia, hasta, completada, completadaEn, creado
    match /usuarios/{uid}/notas/{nota} {
      // Solo el dueño las ve y puede borrarlas del historial.
      allow read, delete: if esDueno(uid);

      allow create: if esDueno(uid)
        && request.resource.data.keys().hasOnly(['titulo', 'texto', 'importancia', 'hasta', 'completada', 'completadaEn', 'creado'])
        && texto(request.resource.data.titulo, 80)
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 500
        && request.resource.data.importancia in ['alta', 'media', 'baja']
        && (request.resource.data.hasta == null || request.resource.data.hasta is timestamp)
        && request.resource.data.completada == false
        && request.resource.data.creado == request.time;

      // Solo se marca como completada o se devuelve a pendientes.
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completada', 'completadaEn'])
        && request.resource.data.completada is bool;
    }

    // ---- Pausas creadas por RH (activa, motivacional, campaña, sugerencia) ----
    // ediciones/{id}: uid (dueño), tipo, titulo, estado, creado, ...contenido
    match /ediciones/{id} {
      // El dueño lee y lista sus ediciones (consultas filtradas por uid).
      allow read: if autenticado() && resource.data.uid == request.auth.uid;
      // Cualquiera con el enlace puede abrir UNA edición activa (no listar).
      allow get: if resource.data.estado == 'activa';

      allow create: if autenticado()
        && request.resource.data.keys().hasAll(['uid', 'tipo', 'titulo', 'estado', 'creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.tipo in tiposValidos()
        && texto(request.resource.data.titulo, 200)
        && request.resource.data.estado in ['borrador', 'activa', 'cerrada']
        && request.resource.data.creado == request.time;

      // El dueño puede editar, pero no cambiar de dueño, tipo ni fecha de creación.
      allow update: if autenticado()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.creado == resource.data.creado
        && texto(request.resource.data.titulo, 200)
        && request.resource.data.estado in ['borrador', 'activa', 'cerrada'];

      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    // ---- Enlaces cortos: cortos/{código} → { e: id de la edición, uid, creado } ----
    match /cortos/{codigo} {
      // Cualquiera con el enlace corto puede abrirlo (no listar todos).
      allow get: if true;
      // Solo el dueño de la edición crea su código; si el código ya existe, se rechaza
      // (sería una actualización) y la app prueba otro.
      allow create: if autenticado()
        && codigo.matches('^[A-Za-z0-9]{6}$')
        && request.resource.data.keys().hasOnly(['e', 'uid', 'creado'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.e is string
        && get(/databases/$(database)/documents/ediciones/$(request.resource.data.e)).data.uid == request.auth.uid
        && request.resource.data.creado == request.time;
      allow delete: if autenticado() && resource.data.uid == request.auth.uid;
    }

    // ---- Registros de participación (quién, cómo y qué) ----
    // registros/{id}: edicionId, propietario, tipo, participante{}, contenido{}, medio{}, authUid?, creado
    match /registros/{id} {
      function edicion() {
        return get(/databases/$(database)/documents/ediciones/$(request.resource.data.edicionId)).data;
      }
      // Si la pausa tiene horario activo, solo se responde entre inicio y fin.
      function enHorario(ed) {
        let h = ed.get('horario', {});
        return h.get('activo', false) != true
          || ((h.get('inicio', null) == null || request.time >= h.get('inicio', null))
              && (h.get('fin', null) == null || request.time <= h.get('fin', null)));
      }

      // Solo el usuario de RH dueño de la edición ve sus registros.
      allow read: if autenticado() && resource.data.propietario == request.auth.uid;

      // Cualquier colaborador con el enlace puede registrar su participación,
      // siempre que la edición exista, esté activa y los datos coincidan con ella.
      allow create: if request.resource.data.keys().hasOnly(['edicionId', 'propietario', 'tipo', 'participante', 'contenido', 'medio', 'authUid', 'creado'])
        && request.resource.data.keys().hasAll(['edicionId', 'propietario', 'tipo', 'participante', 'contenido', 'medio', 'creado'])
        && request.resource.data.edicionId is string
        && exists(/databases/$(database)/documents/ediciones/$(request.resource.data.edicionId))
        && edicion().estado == 'activa'
        && enHorario(edicion())
        && request.resource.data.propietario == edicion().uid
        && request.resource.data.tipo == edicion().tipo
        && request.resource.data.participante is map
        && request.resource.data.contenido is map
        && request.resource.data.medio is map
        && request.resource.data.creado == request.time
        && (!('authUid' in request.resource.data)
            || (autenticado() && request.resource.data.authUid == request.auth.uid));

      // Los registros son evidencia: no se modifican ni se borran desde la app.
      allow update, delete: if false;
    }

    // Todo lo demás queda denegado por defecto.
  }
}
